    {
      "parameters": {
        "jsCode": "const checks = ['Check bapm run','Check ai run','Check marketing run'];\nconst repos = ['ba-pm-jobs-internships','ai-automation-jobs-internships','marketing-jobs-internships'];\n// UTC snapshot date, matching the refresh workflow's UTC dating.\nconst today = new Date().toISOString().slice(0,10);\nconst results = [];\nlet ok = true;\nfor (let i = 0; i < checks.length; i++) {\n  const items = $items(checks[i]);\n  const runs = (items[0] && items[0].json && items[0].json.workflow_runs) || [];\n  // Only default-branch (main) runs count: branch rehearsal/push runs are not the production refresh.\n  // The HTTP nodes already ask the API for branch=main, so this is a belt-and-suspenders filter.\n  const mainRuns = runs.filter(r => r.head_branch === 'main');\n  const todays = mainRuns.filter(r => String(r.created_at||'').slice(0,10) === today);\n  const sched = todays.filter(r => r.event === 'schedule');\n  // The monitored question is specifically: did TODAY'S SCHEDULED production refresh succeed on main?\n  // A manual dispatch success must NOT satisfy this (scheduled_today would be empty).\n  // queued / in_progress / missing / failed / API error never count as success.\n  const goodRun = sched.find(r => r.status === 'completed' && r.conclusion === 'success');\n  const latest = todays[0] || null;\n  const good = Boolean(goodRun);\n  if (!good) ok = false;\n  results.push({\n    repo: repos[i],\n    ran_today: todays.length > 0,\n    scheduled_runs_today: sched.length,\n    good,\n    latest_today: latest ? { status: latest.status, conclusion: latest.conclusion, event: latest.event, head_branch: latest.head_branch, created_at: latest.created_at, url: latest.html_url } : null,\n    scheduled_today: sched.map(r => ({ status: r.status, conclusion: r.conclusion, created_at: r.created_at, url: r.html_url }))\n  });\n}\nconst summary = { date_utc: today, ok, results, note: 'Career refresh monitor: each site needs a SUCCESSFUL SCHEDULE-EVENT main-branch refresh run today (UTC). Manual dispatch success, queued/in_progress/missing/failed/API error never count as success.' };\nconsole.log(JSON.stringify(summary));\nreturn [{ json: summary }];"
      },
