      "parameters": {"mode": "runOnceForAllItems", "jsCode": "const checks = ['Check bapm run','Check ai run','Check marketing run'];\nconst repos = ['ba-pm-jobs-internships','ai-automation-jobs-internships','marketing-jobs-internships'];\nconst today = new Date().toISOString().slice(0,10);\nconst results = [];\nlet ok = true;\nfor (let i = 0; i < checks.length; i++) {\n  const items = $items(checks[i]);\n  const run = items[0] && items[0].json && items[0].json.workflow_runs && items[0].json.workflow_runs[0];\n  const ran_today = run && String(run.created_at||'').slice(0,10) === today;\n  const success = run && run.status === 'completed' && run.conclusion === 'success';\n  const good = Boolean(ran_today && success);\n  if (!good) ok = false;\n  results.push({ repo: repos[i], ran_today: Boolean(ran_today), conclusion: run ? run.conclusion : 'no-run', run_url: run ? run.html_url : null });\n}\nconst summary = { date: today, ok, results, note: 'Career refresh monitor: all 3 sites must have a successful refresh run today.' };\nconsole.log(JSON.stringify(summary));\nreturn [{ json: summary }];"},
